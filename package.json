{
  "name": "restapi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -- --port 3500 ",
    "dev:testing": "dotenv -e ./env/.env.testing -- next dev -- --port 3500",
    "dev:main": "dotenv -e ./env/.env.main -- next dev -- --port 3500",
    "build": "next build",
    "build:testing": "dotenv -e ./env/.env.testing -- next build",
    "build:main": "dotenv -e ./env/.env.main -- next build",
    "start": "next start",
    "start:testing": "dotenv -e ./env/.env.testing -- next start",
    "start:main": "dotenv -e ./env/.env.main -- next start",
    "lint": "next lint",
    "prisma:migrate": "dotenv -e .env -- npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:push:main": "dotenv -e ./env/.env.main -- npx prisma db push",
    "prisma:push:testing": "dotenv -e ./env/.env.testing npx -- prisma db push",
    "prisma:pull:testing": "dotenv -e ./env/.env.testing -- npx prisma db pull"
  },
  "dependencies": {
