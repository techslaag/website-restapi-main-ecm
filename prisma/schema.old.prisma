  auto_win_min_conversions Int?
  auto_win_min_duration    Int?
  auto_win_chance_original Float?
  status                   mod180_tve_leads_split_test_status?
}

model mod180_tve_leads_split_test_items {
  id                 Int       @id @default(autoincrement())
  test_id            Int?
  main_group_id      Int?
  form_type_id       Int?
  variation_key      Int?
  is_control         Int?      @default(0)
  is_winner          Int?      @default(0)
  impressions        Int?      @default(0)
  unique_impressions Int?      @default(0)
  conversions        Int?      @default(0)
  active             Int       @default(1) @db.TinyInt
  stopped_date       DateTime? @db.DateTime(0)
}

model mod180_userfeedback_surveys {
  id            BigInt                              @id @default(autoincrement())
  title         String?                             @db.VarChar(128)
  status        mod180_userfeedback_surveys_status? @default(draft)
  questions     String?                             @db.LongText
  impressions   BigInt                              @default(0)
  settings      String?                             @db.Text
  notifications String?                             @db.Text
  publish_at    DateTime?                           @db.Timestamp(0)
  created_at    DateTime?                           @default(now()) @db.Timestamp(0)
}

model mod180_usermeta {
  umeta_id   BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt       @default(0) @db.UnsignedBigInt
  meta_key   String?      @db.VarChar(255)
  meta_value String?      @db.LongText
  user       mod180_users @relation(fields: [user_id], references: [ID])

  @@index([meta_key(length: 191)], map: "meta_key")
  @@index([user_id], map: "user_id")
}

model mod180_users {
  ID                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_login          String            @default("") @db.VarChar(60)
  user_pass           String            @default("") @db.VarChar(255)
  user_nicename       String            @default("") @db.VarChar(50)
  user_email          String            @default("") @db.VarChar(100)
  user_url            String            @default("") @db.VarChar(100)
  user_registered     DateTime?         @default(now()) @db.DateTime(0)
  user_activation_key String            @default("") @db.VarChar(255)
  user_status         Int               @default(0)
  display_name        String            @default("") @db.VarChar(250)
  posts               mod180_posts[]
  metas               mod180_usermeta[]

  @@index([user_email], map: "user_email")
  @@index([user_login], map: "user_login_key")
  @@index([user_nicename], map: "user_nicename")
}

model mod180_wap_nex_forms_temp_report {
  Id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
}

model mod180_wcpdf_invoice_number {
  id                Int       @id @default(autoincrement())
  order_id          Int?
  date              DateTime? @default(now()) @db.DateTime(0)
  calculated_number Int?
}

model mod180_wpforms_entries {
  entry_id      BigInt   @id @default(autoincrement())
  form_id       BigInt
  post_id       BigInt
  user_id       BigInt
  status        String   @db.VarChar(30)
  type          String   @db.VarChar(30)
  viewed        Boolean? @default(false)
  starred       Boolean? @default(false)
  fields        String   @db.LongText
  meta          String   @db.LongText
  date          DateTime @db.DateTime(0)
  date_modified DateTime @db.DateTime(0)
  ip_address    String   @db.VarChar(128)
  user_agent    String   @db.VarChar(256)
  user_uuid     String   @db.VarChar(36)

  @@index([form_id], map: "form_id")
}

model mod180_wpforms_entry_fields {
  id       BigInt   @id @default(autoincrement())
  entry_id BigInt
  form_id  BigInt
  field_id Int
  value    String   @db.LongText
  date     DateTime @db.DateTime(0)

  @@index([entry_id], map: "entry_id")
  @@index([field_id], map: "field_id")
  @@index([form_id], map: "form_id")
}

model mod180_wpforms_entry_meta {
  id       BigInt   @id @default(autoincrement())
  entry_id BigInt
  form_id  BigInt
  user_id  BigInt
  status   String   @db.VarChar(30)
  type     String   @db.VarChar(30)
  data     String   @db.LongText
  date     DateTime @db.DateTime(0)

  @@index([entry_id], map: "entry_id")
}

model mod180_yoast_indexable_hierarchy {
  indexable_id Int    @default(0) @db.UnsignedInt
  ancestor_id  Int    @default(0) @db.UnsignedInt
  depth        Int?   @db.UnsignedInt
  blog_id      BigInt @default(1)

  @@id([indexable_id, ancestor_id])
  @@index([ancestor_id], map: "ancestor_id")
  @@index([depth], map: "depth")
  @@index([indexable_id], map: "indexable_id")
}

model mod180_yoast_migrations {
  id      Int     @id @default(autoincrement()) @db.UnsignedInt
  version String? @unique(map: "mod180_yoast_migrations_version")
}

model mod180_yoast_primary_term {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  post_id    BigInt?
  term_id    BigInt?
  taxonomy   String    @db.VarChar(32)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  blog_id    BigInt    @default(1)

  @@index([post_id, taxonomy], map: "post_taxonomy")
  @@index([post_id, term_id], map: "post_term")
}

model mod180_yoast_prominent_words {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  stem         String?
  indexable_id Int?    @db.UnsignedInt
  weight       Float?  @db.Float

  @@index([indexable_id], map: "indexable_id")
  @@index([indexable_id, stem], map: "indexable_id_and_stem")
  @@index([stem], map: "stem")
}

model mod180_yoast_seo_links {
  id                  BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  url                 String  @db.VarChar(255)
  post_id             BigInt  @db.UnsignedBigInt
  target_post_id      BigInt  @db.UnsignedBigInt
  type                String  @db.VarChar(8)
  indexable_id        Int?    @db.UnsignedInt
  target_indexable_id Int?    @db.UnsignedInt
  height              Int?    @db.UnsignedInt
  width               Int?    @db.UnsignedInt
  size                Int?    @db.UnsignedInt
  language            String? @db.VarChar(32)
  region              String? @db.VarChar(32)

  @@index([indexable_id, type], map: "indexable_link_direction")
  @@index([post_id, type], map: "link_direction")
}

model mod180_yoast_seo_meta {
  object_id           BigInt @unique(map: "object_id") @db.UnsignedBigInt
  internal_link_count Int?   @db.UnsignedInt
  incoming_link_count Int?   @db.UnsignedInt
}

enum mod180_userfeedback_surveys_status {
  publish
  draft
  trash
}

enum mod180_tve_leads_split_test_status {
  created
  running
  completed
  archived
}

/////////////////////////////////////////////////////////
//
//     CUSTOM TABLES
//
/////////////////////////////////////////////////////////

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "userId")
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @db.Text
  userId        String
  expires       DateTime
  userAgent     String
  userIpAddress String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "userId")
}

enum UserSignUpType {
  registered
  created
}

model User {
  id                String           @id @default(cuid())
  name              String?
  email             String?          @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  signUpType        UserSignUpType   @default(registered)
  passwordUpdatedAt DateTime?
  locale            String?
  admin             Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime?
  accounts          Account[]
  sessions          Session[]
  preference        UserProfile?
  newsletters       UserNewsletter[]
  subscriptions     Subscription[]
  purchases         Purchase[]
  payments          Payment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  businessName    String?
  businessRole    String?
  businessService String?
  businessSize    String?
  homeOffers      Boolean
  partnerOffers   Boolean
  noOffers        Boolean
  createdAt       DateTime
  updatedAt       DateTime?

  @@unique([userId])
}

model Newsletter {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  description         String?          @db.Text
  mailchimpAudienceId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime?
  users               UserNewsletter[]
}

model UserNewsletter {
  user              User       @relation(fields: [userId], references: [id])
  newsletter        Newsletter @relation(fields: [newsletterId], references: [id])
  assignedAt        DateTime   @default(now())
  usedEmail         String // the user email can change over the time
  mailchimpMemberId String?
  userId            String
  newsletterId      String

  @@id([userId, newsletterId])
}

model HeadingPost {
  id        String       @id @default(cuid())
  order     Int
  post      mod180_posts @relation(fields: [postId], references: [ID])
  createdAt DateTime     @default(now())
  updatedAt DateTime?
  postId    BigInt       @db.UnsignedBigInt
}

model Postvisit {
  id          String       @id @default(cuid())
  post        mod180_posts @relation(fields: [postId], references: [ID])
  ipAddress   String
  userAgent   String
  totalVisits Int
  dayVisits   Int
  weekVisits  Int
  monthVisits Int
  yearVisits  Int
  createdAt   DateTime
  updatedAt   DateTime?
  postId      BigInt       @db.UnsignedBigInt

  @@unique([ipAddress, userAgent, postId])
}

model Plan {
  id                           String         @id @default(cuid())
  planType                     PlanType
  title                        String
  description                  String?
  digitalBiweeklyVersion       Boolean        @default(false)
  digitalMagazineVersion       Boolean        @default(false)
  digitalSpecialIssuesVersion  Boolean        @default(false)
  physicalBiweeklyVersion      Boolean        @default(false)
  physicalMagazineVersion      Boolean        @default(false)
  physicalSpecialIssuesVersion Boolean        @default(false)
  biweeklyDigitalPreview       Boolean        @default(false)
  magazineDigitalPreview       Boolean        @default(false)
  specialIssuesDigitalPreview  Boolean        @default(false)
  premiumPosts                 Boolean        @default(false)
  exclusivity                  Boolean        @default(false)
  monthlyPrice                 Decimal        @default(0.00) @db.Decimal(12, 2)
  yearlyPrice                  Decimal        @default(0.00) @db.Decimal(12, 2)
  amountCurrency               Currency
  upgradable                   Boolean        @default(false)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime?
  updatedById                  String?
  archivedAt                   DateTime?
  subscriptions                Subscription[]
}

enum PlanType {
  premium
  ecomember
}

enum Currency {
  xaf
  xof
  usd
  eur
  gbp
}

enum PaymentStatus {
  succeeded
  failed
  processing
}

enum PaymentProviderName {
  stripe
  flutterwave
}

enum ProviderPaymentMethod {
  card
  mobile_money_franco
}

model Payment {
  id                      String                 @id @default(cuid())
  user                    User                   @relation(fields: [userId], references: [id])
  clientCountryAlpha2Code String?
  externalId              String
  reference               String                 @unique
  status                  PaymentStatus
  paidAmount              Decimal                @default(0.00) @db.Decimal(12, 2)
  paidAmountCurrency      Currency
  receivedAmount          Decimal                @default(0.00) @db.Decimal(12, 2)
  receivedCurrency        Currency
  provider                PaymentProviderName
  providerPaymentMethod   ProviderPaymentMethod?
  mobileOperator          String? // used when a mobile payment is involved
  paymentProvider         PaymentProvider?       @relation(fields: [paymentProviderId], references: [id])
  paymentProviderId       String?
  meta                    Json?
  errors                  Json?
  webhookPayloads         Json?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime?
  updatedById             String?
  purchases               Purchase[]
  subscriptions           Subscription[]
  userId                  String
}

model PaymentProvider {
  id               String      @id @default(cuid())
  reference        String      @unique
  commonIdentifier String
  logoUrl          String?
  name             String
  countryAlpha2    String
  countryAlpha3    String
  currency         Currency
  paymentType      PaymentType
  createdAt        DateTime    @default(now())
  disabledAt       DateTime?
  updatedAt        DateTime?
  updatedById      String?
  payments         Payment[]
}

enum PaymentType {
  card
  mobile
  digital_wallet // google pay, apple pay, samsung pay
}

enum SubscriptionPeriod {
  month
  year
}

model Subscription {
  id          String             @id @default(cuid())
  reference   String             @unique
  plan        Plan               @relation(fields: [planId], references: [id])
  period      SubscriptionPeriod @default(month)
  planId      String
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  paymentId   String?
  user        User               @relation(fields: [userId], references: [id])
  userId      String
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?
  updatedById String?
}

enum PurchaseEntityType {
  post
  magazine // magazine
  biweekly // bihebdomadaire
  special_issues // hors séries
}

model Purchase {
  id          String             @id @default(cuid())
  entityType  PurchaseEntityType
  post        mod180_posts       @relation(fields: [postId], references: [ID])
  postId      BigInt             @db.UnsignedBigInt
  payment     Payment            @relation(fields: [paymentId], references: [id])
  paymentId   String
  user        User               @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?
  updatedById String?
}

model StripeWebhook {
  id         String   @id @default(cuid())
  externalId String
  url        String
  secret     String
  events     String
  liveMode   Boolean
  createdAt  DateTime @default(now())
}

model IpLookupBackup {
  id                String   @id @default(cuid())
  ipAddress         String   @unique
  countryAlpha2Code String
  countryName       String?
  currencyCode      String
  timeZones         String?
  isProxy           Boolean  @default(false)
  createdAt         DateTime @default(now())
}

enum ExchangeRatesProvider {
  exchangeRateApi
}

model CurrencyExchangeRates {
  id        String                @id @default(cuid())
  provider  ExchangeRatesProvider
  currency  String                @unique
  data      Json
  createdAt DateTime              @default(now())
  updatedAt DateTime?
}

enum Continent {
  Asia
  Africa
  NordAmerica
  SouthAmerica
  Antarctica
  Europe
  Oceania
}

model Country {
  id               String    @id @default(cuid())
  countryName      String
  isoCode2         String    @db.Char(2)
  isoCode3         String    @db.Char(3)
  numericCode      Int
  capital          String?
  population       Int?
  area             Float?
  currencyCode     String    @db.Char(3)
  officialLanguage String?   @db.VarChar(100)
  continent        Continent
  timeZone         String?
  callingCode      String?   @db.VarChar(10)
  internetTLD      String?   @db.VarChar(10) // Top-level domain (e.g., .us, .fr)
  gdp              Float? // Gross Domestic Product
  hdi              Float? // Human Development Index
  energies         Energy[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?
  Region           Region[]
}

model Region {
  id              String       @id @default(cuid())
  name            String
  area            Float?
  population      Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?
  departments     Department[] @relation("regionsPart")
  chiefDepartment Department?  @relation("regionCapital")
  country         Country      @relation(fields: [countryId], references: [id])
  countryId       String
}

model Department {
  id                          String    @id @default(cuid())
  name                        String
  area                        Float?
  population                  Int?
  averagePriceBuiltBuilding   Decimal?  @default(0.00) @db.Decimal(12, 2)
  averagePriceUnbuiltBuilding Decimal?  @default(0.00) @db.Decimal(12, 2)
  region                      Region    @relation("regionsPart", fields: [regionId], references: [id])
  regionId                    String
  regionCapital               Region?   @relation("regionCapital", fields: [regionCapitalId], references: [id])
  regionCapitalId             String?   @unique
  communes                    Commune[] @relation("departmentPart")
  chielfCommune               Commune?  @relation("departmentCapital")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime?
}

enum CommuneType {
  districtMunicipality
  ruralCommune
}

model Commune {
  id                          String          @id @default(cuid())
  name                        String
  area                        Float?
  population                  Int?
  averagePriceBuiltBuilding   Decimal?        @default(0.00) @db.Decimal(12, 2)
  averagePriceUnbuiltBuilding Decimal?        @default(0.00) @db.Decimal(12, 2)
  type                        CommuneType
  departmentId                String
  departmentCapitalId         String?         @unique
  department                  Department      @relation("departmentPart", fields: [departmentId], references: [id])
  departmentCapital           Department?     @relation("departmentCapital", fields: [departmentCapitalId], references: [id])
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime?
  neighborhoods               Neighborhood[]
  productOnPrice              ProductInCity[]
}

model Neighborhood {
  id                          String        @id @default(cuid())
  name                        String
  averagePriceBuiltBuilding   Decimal?      @default(0.00) @db.Decimal(12, 2)
  averagePriceUnbuiltBuilding Decimal?      @default(0.00) @db.Decimal(12, 2)
  area                        Float?
  population                  Int?
  communeId                   String
  commune                     Commune       @relation(fields: [communeId], references: [id])
  successorId                 String?       @unique
  successor                   Neighborhood? @relation("NeighborhoodHistory", fields: [successorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  predecessor                 Neighborhood? @relation("NeighborhoodHistory")
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime?
}

enum FoodMainClass {
  DairyProducts
  FatsAndOils
  ConsumerIceCream
  FruitsAndVegetables
  Confectionery
  CerealsAndCerealBasedProducts
  BakeryProducts
  MeatAndMeatProducts
  FishAndFisheryProducts
  EggsAndEggProducts
  Sweeteners
  SaltSpicesSoupsSauces
  Salads
  FoodsIntendedForSpecialDiets
  Beverages
}

enum FoodAdditives {
  FoodsColors
  Preservatives
  AntioxidantsAndAcidityRegulators
  TextureAgents
  EmulsifiersAndStabilizers
  FlavorEnhancers
  Miscellaneous
}

enum FoodOriginAndTreatment {
  ProductsAnimal
  ProductsPlant
  ProcessedProducts
  Beverages
  GroceryProducts
}

enum FoodNutritionalClass {
  Proteins
  Carbohydrates
  Fat
  VitaminsAndMinerals
}

enum FoodSpecialClass {
  Organic
  GlutenFree
  VegetarianVegan
  FunctionalFortified
}

enum MeasurementType {
  Energy
  Product
}

model Measurement {
  id        String          @id @default(cuid())
  name      String
  notation  String
  type      MeasurementType
  createdAt DateTime        @default(now())
  updatedAt DateTime?
  products  Product[]
  energies  Energy[]
}

model Product {
  id                  String                  @id @default(cuid())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime?
  name                String
  description         String
  unitOfMeasurementId String
  unitOfMeasurement   Measurement             @relation(fields: [unitOfMeasurementId], references: [id])
  mainClass           FoodMainClass
  additives           FoodAdditives?
  originAndTreatment  FoodOriginAndTreatment?
  nutritionalClass    FoodNutritionalClass
  specialClass        FoodSpecialClass?
  communeOnPrice      ProductInCity[]
}

enum Avalaibility {
  Avalaible
  Unavalaible
}

model ProductInCity {
  cityId       String
  productId    String
  city         Commune      @relation(fields: [cityId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  price        Decimal      @default(0.00) @db.Decimal(12, 2)
  currency     Currency
  avalaibility Avalaibility
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?
  entryDate    DateTime

  successor                   ProductInCity? @relation("PriceHistory", fields: [productCityOnPriceCityId, productCityOnPriceProductId], references: [cityId, productId], onUpdate: NoAction, onDelete: NoAction)
  predecessor                 ProductInCity? @relation("PriceHistory")
  productCityOnPriceCityId    String?
  productCityOnPriceProductId String?

  @@id([cityId, productId], name: "ProductInCityId")
  @@unique([productCityOnPriceCityId, productCityOnPriceProductId])
}

model Energy {
  id            String      @id @default(cuid())
  name          String
  price         Decimal     @default(0.00) @db.Decimal(12, 2)
  currency      Currency
  measurement   Measurement @relation(fields: [measurementId], references: [id])
  measurementId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime?
  successorId   String?     @unique
  successor     Energy?     @relation("EnergyHistory", fields: [successorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  predecessor   Energy?     @relation("EnergyHistory")
  country       Country     @relation(fields: [countryId], references: [id])
  countryId     String
}

model FinancialWeekUser {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  prenom     String
  nom        String
  entreprise String
  poste      String
  phone      String
  package    PackageType? // Ajout de `?` pour autoriser la valeur null
  password   String
  createdAt  DateTime    @default(now())
}

enum PackageType {
  PREMIUM
  PARTENAIRE
  SOUTIENT
}
