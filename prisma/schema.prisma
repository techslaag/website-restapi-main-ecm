  user       User      @relation(fields: [userId], references: [id])
}

model Preference {
  id         String  @id @default(uuid())
  userId     String  @unique
  categories String  @db.LongText
  fcmToken   String?
  user       User    @relation(fields: [userId], references: [id])
}

model FcmToken {
  id          String    @id @default(cuid())
  token       String    @unique @db.VarChar(500)
  userId      String
  deviceId    String?   @db.VarChar(255)
  platform    String?   @db.VarChar(50)  // 'ios', 'android', 'web'
  appVersion  String?   @db.VarChar(50)
  isActive    Boolean   @default(true)
  lastUsed    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleNotifications ArticleNotification[]

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@index([lastUsed])
}

model Interest {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  description   String?               @db.Text
  categoryId    BigInt?               @db.UnsignedBigInt
  groupeId      String?               // rubriques, zones-geographiques, autres
  order         Int                   @default(0) // for custom ordering within groups
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      mod180_term_taxonomy? @relation(fields: [categoryId], references: [term_taxonomy_id], onDelete: SetNull)
  userInterests UserInterest[]

  @@index([slug])
  @@index([categoryId])
  @@index([groupeId])
  @@index([order])
  @@index([groupeId, order])
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Automation {
  id        String         @id @default(cuid())
  name      String
  type      AutomationType
  active    Boolean        @default(false)
  settings  String?        @db.LongText
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
  emailJobs EmailJob[]
}

model EmailJob {
  id           String         @id @default(cuid())
  automationId String
  userId       String
  templateType EmailTemplate
  status       EmailJobStatus @default(pending)
  scheduledFor DateTime
  sentAt       DateTime?
  emailData    String?        @db.LongText
  error        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt
  automation   Automation     @relation(fields: [automationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])

  @@index([status, scheduledFor])
  @@index([automationId])
  @@index([userId])
}

model EmailLog {
  id           String        @id @default(cuid())
  userId       String
  templateType EmailTemplate
  subject      String
  status       String
  sentAt       DateTime      @default(now())
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?       @db.Text
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([templateType])
  @@index([sentAt])
}

model mod180_wsal_metadata {
  id            BigInt @id @default(autoincrement())
  occurrence_id BigInt
  name          String @db.VarChar(100)
  value         String @db.LongText

  @@index([name, value(length: 64)], map: "name_value")
  @@index([occurrence_id, name], map: "occurrence_name")
}

model mod180_wsal_occurrences {
  id          BigInt  @id @default(autoincrement())
  site_id     BigInt
  alert_id    BigInt
  created_on  Float
  client_ip   String  @db.VarChar(255)
  severity    String  @db.VarChar(255)
  object      String  @db.VarChar(255)
  event_type  String  @db.VarChar(255)
  user_agent  String  @db.VarChar(255)
  user_roles  String  @db.VarChar(255)
  username    String? @db.VarChar(255)
  user_id     BigInt?
  session_id  String  @db.VarChar(255)
  post_status String  @db.VarChar(255)
  post_type   String  @db.VarChar(255)
  post_id     BigInt

  @@index([created_on], map: "created_on")
  @@index([site_id, alert_id, created_on], map: "site_alert_created")
  @@index([user_id, username], map: "wsal_users")
}

model AbandonedSubscription {
  id                      String                          @id @default(cuid())
  sessionId               String?
  userId                  String?
  planId                  String
  period                  Subscription_period             @default(month)
  email                   String?
  step                    AbandonedSubscriptionStep
  status                  AbandonedSubscriptionStatus     @default(abandoned)
  userAgent               String?                         @db.LongText
  ipAddress               String?
  referrer                String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  metadata                String?                         @db.LongText
  abandonedAt             DateTime                        @default(now())
  lastActivityAt          DateTime                        @default(now())
  recoveredAt             DateTime?
  completedSubscriptionId String?
  remindersSent           Int                             @default(0)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime?
  user                    User?                           @relation(fields: [userId], references: [id])
  plan                    Plan                            @relation(fields: [planId], references: [id])
  completedSubscription   Subscription?                   @relation(fields: [completedSubscriptionId], references: [id])
  activities              AbandonedSubscriptionActivity[]

  @@index([sessionId])
  @@index([userId])
  @@index([email])
  @@index([planId])
  @@index([status])
  @@index([step])
  @@index([abandonedAt])
}

model AbandonedSubscriptionActivity {
  id                      String                    @id @default(cuid())
  abandonedSubscriptionId String
  step                    AbandonedSubscriptionStep
  action                  String
  metadata                String?                   @db.LongText
  timestamp               DateTime                  @default(now())
  abandonedSubscription   AbandonedSubscription     @relation(fields: [abandonedSubscriptionId], references: [id], onDelete: Cascade)

  @@index([abandonedSubscriptionId])
  @@index([step])
}

