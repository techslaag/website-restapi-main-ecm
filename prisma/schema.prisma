// Notification System Models




model NotificationLog {
  id           String               @id @default(cuid())
  requestId    String               @unique
  type         String
  title        String               @db.VarChar(500)
  body         String               @db.Text
  audience     NotificationAudience
  targetCount  Int                  @default(0)
  successCount Int                  @default(0)
  failureCount Int                  @default(0)
  userId       String
  campaignId   String?
  templateId   String?
  priority     NotificationPriority @default(normal)
  dryRun       Boolean              @default(false)
  metadata     Json?
  createdAt    DateTime             @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([campaignId])
  @@index([templateId])
  @@index([type])
  @@index([audience])
  @@index([createdAt])
}

model ScheduledNotification {
  id                String                      @id @default(cuid())
  requestId         String                      @unique
  type              String
  title             String                      @db.VarChar(500)
  body              String                      @db.Text
  audience          NotificationAudience
  targetUserId      String?
  customFcmToken    String?                     @db.Text
  data              Json?
  segmentCriteria   Json?
  priority          NotificationPriority        @default(normal)
  templateId        String?
  campaignId        String?
  scheduledAt       DateTime
  timezone          String                      @default("UTC")
  recurrence        NotificationRecurrence      @default(none)
  recurrenceEnd     DateTime?
  maxRetries        Int                         @default(3)
  retryCount        Int                         @default(0)
  status            ScheduledNotificationStatus @default(scheduled)
  result            Json?
  lastError         String?                     @db.Text
  sentAt            DateTime?
  failedAt          DateTime?
  parentId          String?
  userId            String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent   ScheduledNotification? @relation("RecurringNotification", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children ScheduledNotification[] @relation("RecurringNotification")

  @@index([userId])
  @@index([templateId])
  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([parentId])
}

model ArticleNotification {
  id        String   @id @default(cuid())
  userId    String
  articleId BigInt   @db.UnsignedBigInt
  sentAt    DateTime @default(now())
  fcmTokenId String?
  success   Boolean  @default(true)
  errorMessage String?
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   mod180_posts @relation(fields: [articleId], references: [ID], onDelete: Cascade)
  fcmToken  FcmToken?    @relation(fields: [fcmTokenId], references: [id], onDelete: SetNull)

  @@unique([userId, articleId, fcmTokenId])
  @@index([userId])
  @@index([articleId])
  @@index([sentAt])
}

model AiNewsletterSuggestion {
  id        String   @id @default(cuid())
  type      String   // 'flash-info', 'finance-week', etc.
  data      Json     // JSON data containing the suggestions
  date      DateTime @db.Date  // Date for which this suggestion was generated
  groupNumber Int    // 1, 2, or 3 for multiple suggestions per day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, date, groupNumber])
  @@index([type])
  @@index([date])
  @@index([type, date])
}

// Free Article Read System - Mobile App Only
// Allows non-subscribers to read limited premium articles for free

enum FreeArticleType {
  premium    // Max 5 lifetime reads
  ecomembre  // Max 1 lifetime read
}

model FreeArticleRead {
  id          String          @id @default(cuid())
  userId      String
  articleId   BigInt          @db.UnsignedBigInt
  articleType FreeArticleType
  readAt      DateTime        @default(now())
  deviceId    String?         // Optional device identifier

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  article mod180_posts @relation(fields: [articleId], references: [ID], onDelete: Cascade)

  @@unique([userId, articleId]) // User can only read an article once
  @@index([userId])
  @@index([articleId])
  @@index([articleType])
  @@index([userId, articleType]) // For counting reads by type
}



